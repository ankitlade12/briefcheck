# Optional live AI. No credentials are needed for deterministic review.
# Direct OpenAI (uses gpt-5-mini unless BRIEFCHECK_MODEL is set):
OPENAI_API_KEY=
# Alternative gateway configuration:
AI_GATEWAY_API_KEY=
# Choose a structured-output-capable provider/model from your gateway account.
BRIEFCHECK_MODEL=
# Per-process ceiling; set a monetary spend cap in the provider dashboard too.
BRIEFCHECK_MAX_AI_REVIEWS=30
# Optional authorized review-report destination, configured by the operator.
BRIEFCHECK_WEBHOOK_URL=
BRIEFCHECK_WEBHOOK_TOKEN=
# Set true behind an HTTPS reverse proxy before enabling remote accounts.
BRIEFCHECK_SECURE_COOKIE=false
